{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo (dev menu)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Expo web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Expo iOS",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ios"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Expo Android",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "android"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
